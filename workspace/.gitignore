# The workspace holds 21 GB, of which 18 GB is swarm output. The repo should carry the HANDWRITTEN:
# cells, lane briefs, drivers, notes. Machine output is regenerated by the runs themselves.
results/*
generations/
tasks/graph_runs/
tasks/cloud/receipts/
tasks/cloud_receipts.jsonl

# Runtime traces
*.log
*.pid
*.lock
.ovh_claim
.local_claim
__pycache__/
*.pyc
.venv/
venv/

# Large artifacts: no single file above a few hundred kB belongs in this repo.
*.npz
*.npy
*.vtk
*.vtu
*.stl
*.nii
*.nii.gz
*.h5
*.pt
*.tar.gz
*.zip

# Generated job cards and runtime state in free48 (7500+ files) -- machine output, not source material.
tasks/free48/BT-FW48-*
tasks/free48/STATE.json*
tasks/free48/STATUS.json
tasks/free48/WINDOW.json
tasks/free48/sources_backup_*

# Own backups before editing. Git carries the history now, so they are redundant.
*.bak
.bak_*
*.bak-*
*.bak_*

# Cloud lanes and lane run output: machine generated, regenerated by the runs.
tasks/cloud/lanes/
tasks/cloud/*.json
tasks/cloud/*.jsonl
tasks/lanes/*/
tasks/lanes/bt_queue.txt
tasks/lanes/*.jsonl
tasks/graph_proposals/
tasks/index/
tasks/build_night/swarm/
tasks/free48/SEED_PROGRAM_*.json
tasks/free48/INITIAL_JOBS.json

# ...but the dispatcher scripts under tasks/lanes/ are handwritten and should be tracked.
!tasks/lanes/ovh_agents/
!tasks/lanes/ovh_agents/*.py
!tasks/lanes/ovh_agents/*.sh
!tasks/lanes/seed_unblock_evidence/
!tasks/lanes/seed_unblock_evidence/*.py

# Runtime state under the tracked script directories: not source material, changes every minute.
tasks/lanes/ovh_agents/running/
tasks/lanes/ovh_agents/.*
tasks/build_night/state/
tasks/lanes/seed_unblock_evidence/*.AGENT_EXIT
tasks/lanes/seed_unblock_evidence/*.txt
tasks/lanes/seed_unblock_evidence/*.diff
tasks/lanes/*.out
tasks/lanes/bt_queue.max
tasks/lanes/bt_queue_archive_*.txt
tasks/lanes/cap_swarm_worker_local
tasks/free48/CATALOG.json
tasks/free48/GRAPH_PACKET.json
tasks/free48/proposal_reviews/
tasks/cloud/*.txt
/inputs/
/references/
/graph
/current
/*.json

# ...but the handmade analysis output under results/ASSEMBLY_* is deliverables, not swarm output.
# The line above is results/* and not results/, because git cannot reinclude a file whose parent
# directory is excluded, and the decision outputs that every cited number points to live under it.
!results/ASSEMBLY_*/
!results/ASSEMBLY_*/**

# Third-party material stays local. Of the literature cache only the provenance records
# (*.acquisition.json with requested url, final url, timestamp, byte count and sha256) and the
# OpenAlex metadata are tracked, so the same file can be fetched from its source.
*.pdf
results/*/literature/**/*.txt
results/*/literature/**/*.png
results/*/literature/**/*.jpeg
results/*/literature/**/*.html
results/*/literature/**/*.response
results/*/literature/**/*.failed_response
# matplotlib cache that happened to be saved
**/mplconfig/
**/mpl_config/
**/.mplconfig*/

# Licensed third-party model data and anything derived from it stays local, as its licence requires.
results/D3/
external_mount/
notes/private_*
notes/[A-Z]*_REQUIREMENTS_AND_SOFTWARE.md
notes/[A-Z]*_CHAIN_DECOMPOSITION.md
notes/[A-Z]*_SENSITIVITY_CLASSIFICATION.md
**/mpl_config/**
# Machine-generated indexes over all jobs: hundreds of MB each and regenerable from the runs.
results/ASSEMBLY_FRAME_SHIFT/HITS.json
results/ASSEMBLY_QUANTITY_INDEX/QUANTITY_INDEX_V1.json

# Admission tooling and its output are configuration, not source material.
tasks/assembly/admission*.py
tasks/build_night/*_FILTER.md
**/*_VERDICTS.json

# Local work that is not published.
tasks/lanes/BRAINSTORM_FLEET.md
tasks/lanes/fleet_lenses.tsv
results/BT-FLEET-*
notes/FLEET_*
docs/FLEET_*

# Internal coordinator working log.
tasks/build_night/NIGHT_LOG.md


# The tooling for the language and name pass: working material, not part of the work.
tasks/translate/

    {
      "equation": "J_reabs = Vmax_reabs * C_lumen/(Km_reabs + C_lumen) * f_ion",
      "name": "reabsorption",
      "unit": "mg/min"
    },
    {
      "equation": "dA_lumen/dt = Q_in*C_in - Q_out*C_lumen + J_MATE - J_reabs",
      "name": "lumen_balance",
      "unit": "mg/min"
    },
    {
      "equation": "dV/dt = Q_in - Q_out - Q_water,reabs",
      "name": "water_balance",
      "unit": "mL/min"
    },
    {
      "equation": "dM_urine/dt = Q_out,collecting*C_collecting",
      "name": "urine_outflow",
      "unit": "mg/min"
    },
    {
      "equation": "d(A_p + sum(A_lumen) + sum(A_cell) + M_urine)/dt = 0",
